# Copy this file to .env and fill in the keys you use. .env is git-ignored.
# Every line is optional: a key can also be pasted into the app's sidebar,
# and Ollama needs no key at all.

# Claude    https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ChatGPT   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini    https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: another OpenAI-compatible service (OpenRouter, DeepSeek, ...).
# Put its key in OPENAI_API_KEY and choose "ChatGPT · OpenAI API" in the app.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
